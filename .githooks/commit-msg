#!/bin/sh
# Refuses tool attribution in the message (AGENTS.md, Commits and PRs). Turned on by `uv run tools/setup.py`.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v uv >/dev/null 2>&1; then
    echo "commit-msg: uv not found, hook skipped; gate quick still checks the branch's messages" >&2
    exit 0
fi
[ -f tools/hooks.py ] || exit 0
exec uv run --quiet --no-sync tools/hooks.py commit-msg "$@"
