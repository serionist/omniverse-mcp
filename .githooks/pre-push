#!/bin/sh
# Runs the gate's quick lane before every push. Turned on by `uv run tools/setup.py`.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v uv >/dev/null 2>&1; then
    echo "pre-push: uv not found, hook skipped: the gate did not run (https://docs.astral.sh/uv/)" >&2
    exit 0
fi
[ -f tools/hooks.py ] || exit 0
exec uv run --quiet --no-sync tools/hooks.py pre-push "$@"
