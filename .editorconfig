root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JSON and YAML read better at two.
[*.{json,yml,yaml}]
indent_size = 2

# In Markdown a trailing double space is a line break.
[*.md]
trim_trailing_whitespace = false
