{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached --name-only)",
      "Bash(git diff HEAD)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git diff --name-only origin/main...HEAD)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git fetch origin)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(uv sync)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)",
      "Bash(uv run basedpyright)",
      "Bash(uv run tools/gate.py quick)",
      "Bash(uv run tools/gate.py full)",
      "Bash(uv run tools/gate.py text --file -)",
      "Bash(uv run tools/scenarios.py check)",
      "Bash(uv run tools/scenarios.py compare)"
    ],
    "ask": [
      "Bash(git blame)",
      "Bash(git blame *)",
      "Bash(git diff *../*)",
      "Bash(git diff *..\\*)",
      "Bash(git diff *..\\\\*)",
      "Bash(git diff *..)",
      "Bash(git diff *.. *)",
      "Bash(git diff /*)",
      "Bash(git diff * /*)",
      "Bash(git diff ~*)",
      "Bash(git diff * ~*)",
      "Bash(git diff *$*)",
      "Bash(git diff *:/*)",
      "Bash(git diff *:\\*)",
      "Bash(git diff *:\\\\*)",
      "Bash(git diff \\*)",
      "Bash(git diff \\\\*)",
      "Bash(git diff * \\*)",
      "Bash(git diff * \\\\*)",
      "Bash(git diff *\"/*)",
      "Bash(git diff *\"\\*)",
      "Bash(git diff *\"\\\\*)",
      "Bash(git diff *\"~*)",
      "Bash(git diff *\"..*)",
      "Bash(git diff *'/*)",
      "Bash(git diff *'\\*)",
      "Bash(git diff *'\\\\*)",
      "Bash(git diff *'~*)",
      "Bash(git diff *'..*)",
      "PowerShell(git blame)",
      "PowerShell(git blame *)",
      "PowerShell(git diff *../*)",
      "PowerShell(git diff *..\\*)",
      "PowerShell(git diff *..\\\\*)",
      "PowerShell(git diff *..)",
      "PowerShell(git diff *.. *)",
      "PowerShell(git diff /*)",
      "PowerShell(git diff * /*)",
      "PowerShell(git diff ~*)",
      "PowerShell(git diff * ~*)",
      "PowerShell(git diff *$*)",
      "PowerShell(git diff *:/*)",
      "PowerShell(git diff *:\\*)",
      "PowerShell(git diff *:\\\\*)",
      "PowerShell(git diff \\*)",
      "PowerShell(git diff \\\\*)",
      "PowerShell(git diff * \\*)",
      "PowerShell(git diff * \\\\*)",
      "PowerShell(git diff *\"/*)",
      "PowerShell(git diff *\"\\*)",
      "PowerShell(git diff *\"\\\\*)",
      "PowerShell(git diff *\"~*)",
      "PowerShell(git diff *\"..*)",
      "PowerShell(git diff *'/*)",
      "PowerShell(git diff *'\\*)",
      "PowerShell(git diff *'\\\\*)",
      "PowerShell(git diff *'~*)",
      "PowerShell(git diff *'..*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.token)",
      "Read(**/.claude/settings.local.json)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff --output*)",
      "Bash(git diff *--output*)",
      "Bash(git log --output*)",
      "Bash(git log *--output*)",
      "Bash(git show --output*)",
      "Bash(git show *--output*)",
      "Bash(git blame --contents*)",
      "Bash(git blame *--contents*)",
      "Bash(git blame -S*)",
      "Bash(git blame *-S*)",
      "Bash(git blame --ignore-revs-file*)",
      "Bash(git blame *--ignore-revs-file*)",
      "Bash(git commit --no-v*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git push --no-v*)",
      "Bash(git push *--no-v*)",
      "Bash(uv run ruff *--fix*)",
      "Bash(uv run ruff *--unsafe-fixes*)",
      "Bash(uv run basedpyright*--writebaseline*)",
      "PowerShell(git diff --no-index*)",
      "PowerShell(git diff *--no-index*)",
      "PowerShell(git diff --output*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git log --output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git show --output*)",
      "PowerShell(git show *--output*)",
      "PowerShell(git blame --contents*)",
      "PowerShell(git blame *--contents*)",
      "PowerShell(git blame -S*)",
      "PowerShell(git blame *-S*)",
      "PowerShell(git blame --ignore-revs-file*)",
      "PowerShell(git blame *--ignore-revs-file*)",
      "PowerShell(git commit --no-v*)",
      "PowerShell(git commit *--no-v*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git push --no-v*)",
      "PowerShell(git push *--no-v*)",
      "PowerShell(uv run ruff *--fix*)",
      "PowerShell(uv run ruff *--unsafe-fixes*)",
      "PowerShell(uv run basedpyright*--writebaseline*)"
    ]
  }
}
